fetch_adc()
{
    local adc=$1
    local channel=$2
    local address=$((UCI_ADC + $adc*32 + $channel*4))
    pcireg -dec $address
}



printf "PELLET        : 0x%04X\n" $(fetch_adc 0 0)
printf "VDD_SENSE     : 0x%04X\n" $(fetch_adc 0 1)
printf "VDD_I         : 0x%04X\n" $(fetch_adc 0 2)
printf "AMUXOUT7B     : 0x%04X\n" $(fetch_adc 0 3)
printf "LIQ_FB        : 0x%04X\n" $(fetch_adc 0 4)
