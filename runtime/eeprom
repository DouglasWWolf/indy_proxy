source bash_registers fpga_reg.h


axi()
{
    local addr=$(($1))
    if [[ ! "$1" =~ ^0 ]] && [ "$addr" -eq 0 ]; then
        echo ">>>> UNKNOWN FPGA REGISTER $1 <<<<"
        return 1
    fi
    pcireg $addr "${@:2}"
}

get()
{
    local addr=$(($1))
    if [[ ! "$1" =~ ^0 ]] && [ "$addr" -eq 0 ]; then
        echo ">>>> UNKNOWN FPGA REGISTER $1 <<<<"
        return 1
    fi
    pcireg -dec $addr "${@:2}"
}


eewrite()
{
    local address=$(($1))
    local word=$(($2))

    local WRITE_BIG_ENDIAN=3

    if [ $(get EEPROM_IDLE) -eq 0 ]; then
        echo "Bus is busy during eewrite!"
        return
    fi

    axi EEPROM_ADDRESS $1
    axi EEPROM_WDATA   $2
    axi EEPROM_CMD     $WRITE_BIG_ENDIAN


    # Wait for the command to complete
    while [ $(get EEPROM_IDLE) -eq 0 ]; do
        sleep .001
    done

    local error=$(get EEPROM_ERROR)
    if [ $error -ne 0 ]; then
        echo "Error $error during eewrite"
        return
    fi

}


eeread()
{
    local address=$(($1))

    local READ_BIG_ENDIAN=2

    if [ $(get EEPROM_IDLE) -eq 0 ]; then
        echo "Bus is busy during eewrite!"
        return
    fi

    axi EEPROM_ADDRESS $1
    axi EEPROM_CMD     $READ_BIG_ENDIAN


    # Wait for the command to complete
    while [ $(get EEPROM_IDLE) -eq 0 ]; do
        sleep .001
    done

    local error=$(get EEPROM_ERROR)
    if [ $error -ne 0 ]; then
        echo "Error $error during eewrite"
        return
    fi

    axi EEPROM_RDATA

}

